# Copy this file to `.env` (which is gitignored) and fill in a key.
# The bot's decision agent reads these; Claude Code never sees the values.

# --- LLM provider for the decision agent ---
# PA_PROVIDER=anthropic      # anthropic | gemini | zhipu   (default: anthropic)
# PA_MODEL=                  # override model id (defaults: claude-opus-4-8 / gemini-2.5-flash / glm-4.5-flash)
# PA_EFFORT=medium           # anthropic only: low|medium|high|xhigh|max
# PA_TEMPERATURE=0.1         # near-deterministic so backtests reproduce (gemini/zhipu)
# PA_VISION=0                # 1 = also send a rendered chart image (default numeric-only)
# PA_CACHE=1                 # on-disk decision cache under data/cache/decisions/
# PA_GATE=1                  # zero-cost pre-filter skips obvious no-trade bars
# PA_DAYFILTER=overlap       # day-level chop gate: off | overlap | efficiency | combo | llm
#                            # (C days skipped entirely; llm = Opus judges A/C itself from
#                            #  strictly prospective inputs, graded+reasoned in the journal)
#                            # llm is research-only: a 128-day audit showed zero calibration
#                            # (graded-C afternoons were indistinguishable from A); production
#                            # default stays overlap
# PA_WINDOW=am               # session window: am = 09:30-11:30 entries | pm = 13:30-15:30
#                            # (pm compresses the morning into am_high/am_low/am_close magnets;
#                            #  pm journals go to data/journal_pm/)

# --- backtest runner (scripts/backtest_llm.py) ---
# N_SESSIONS=3               # how many most-recent sessions to run
# PA_WORKERS=3               # concurrent sessions
# PA_BARS=mes_5m.parquet     # 5m parquet under data/raw/

# Anthropic — strongest, paid (https://console.anthropic.com):
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — free tier (https://aistudio.google.com):
# Set PA_PROVIDER=gemini above, then:
# GEMINI_API_KEY=...

# Zhipu GLM — free tier (https://bigmodel.cn , intl: https://z.ai):
# Set PA_PROVIDER=zhipu above, then:
# ZHIPU_API_KEY=xxxxxxxx.yyyyyyyy       # Zhipu keys look like id.secret
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # intl: https://api.z.ai/api/paas/v4
# ZHIPU_MIN_INTERVAL=3                  # seconds between call launches (free-tier rate limit)
# PA_MODEL=glm-4.5-flash                # default text model; strong + R:R-disciplined

# --- SPY live paper line (Alpaca: free IEX data + paper trading) ---
# Create the account + PAPER keys yourself at https://alpaca.markets (dashboard ->
# Paper Trading -> API Keys). Claude never handles the plaintext values.
# ALPACA_API_KEY_ID=...
# ALPACA_API_SECRET_KEY=...
# PA_INSTRUMENT=spy          # instrument for the live loop (mes = backtest mainline)
# LIVE_QTY=50                # shares per trade; point value scales automatically
#                            # (50 shares -> $75 cap = 1.5 SPY pts; 10 -> 7.5 pts)
# PA_RISK_USD=75             # per-trade $ risk cap
# PA_DAILY_LOSS_CAP=500      # halt the day at this loss
# PA_MAX_TRADES=3            # per-session trade cap
# PA_MAX_CONSEC_LOSS=2       # halt after N consecutive losers
# PA_KILL_FILE=              # optional override; default <repo>/KILL

# Later, when we wire MES live execution:
# TRADOVATE_API_KEY=...
# DATABENTO_API_KEY=...
